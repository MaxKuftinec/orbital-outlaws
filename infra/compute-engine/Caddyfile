# Public PREVIEW gate. Gameplay and admin routes are CLOSED until
# authenticated player ownership and live multiplayer security are built
# Caddy provisions TLS for API_DOMAIN once DNS points at the VM
{$API_DOMAIN} {
    encode zstd gzip

    @restricted path /dev /dev/* /players /players/* /worlds /worlds/* /docs /redoc /openapi.json
    respond @restricted "Persistent gameplay API is not yet publicly available" 403

    reverse_proxy api:8000
}
