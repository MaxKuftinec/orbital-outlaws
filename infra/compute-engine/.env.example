# Copy to .env in this directory; .env is gitignored.
# Use a domain you control with DNS A record pointing to the VM static IP.
API_DOMAIN=api.example.com
POSTGRES_DB=orbital_outlaws
POSTGRES_USER=orbital
# Generate URL-safe random hex (example: openssl rand -hex 24).
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD

# Account API is off until real SMTP and strong secret are configured.
AUTH_ENABLED=0
AUTH_SECRET=
# Comma-separated exact HTTPS frontend origins; do not use '*'.
AUTH_ORIGINS=https://your-firebase-project.web.app
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
