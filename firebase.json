{
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{"source": "**", "destination": "/index.html"}],
    "headers": [
      {
        "source": "**/*.@(js|css|woff|woff2|webp|png|svg)",
        "headers": [{"key": "Cache-Control", "value": "public, max-age=3600"}]
      }
    ]
  }
}
